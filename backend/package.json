    "ai": "^6.0.0",
    "hono": "^4.11.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.4.0"
  }
}
