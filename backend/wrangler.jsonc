{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentos-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-19",
  // enable_ctx_exports lets the Sandbox SDK reach the exported ContainerProxy via
  // ctx.exports for credential-less R2 egress mounts (see src/index.ts export).
  "compatibility_flags": ["nodejs_compat", "enable_ctx_exports"],

  "triggers": {
    "crons": ["*/5 * * * *", "0 */6 * * *"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "env": {
    "development": {
      "vars": {
        "ENVIRONMENT": "development",
        "FRONTEND_URL": "http://localhost:5173",
        "BACKEND_URL": "http://localhost:8787"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "thread-forge-db",
          "database_id": "REPLACE_WITH_YOUR_D1_ID"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "thread-forge-assets",
          "preview_bucket_name": "thread-forge-assets"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "REPLACE_WITH_YOUR_KV_ID",
          "preview_id": "REPLACE_WITH_YOUR_KV_PREVIEW_ID"
        }
      ],
      "workflows": [
        {
          "name": "generation-workflow",
          "binding": "GENERATION_WORKFLOW",
          "class_name": "GenerationWorkflow"
        },
        {
          "name": "publish-workflow",
          "binding": "PUBLISH_WORKFLOW",
          "class_name": "PublishWorkflow"
        }
      ],
      "containers": [
        {
          "class_name": "Sandbox",
          "image": "./containers/sandbox/Dockerfile",
          "instance_type": "standard",
          "max_instances": 5
        }
      ],
      "durable_objects": {
        "bindings": [{ "class_name": "Sandbox", "name": "Sandbox" }]
      },
      "migrations": [{ "new_sqlite_classes": ["Sandbox"], "tag": "v1" }]
    }
  },

  "vars": {
    "ENVIRONMENT": "production",
    "FRONTEND_URL": "https://content-generation-chatbot.pages.dev",
    "BACKEND_URL": "https://agentos-backend.nadirhussain03000.workers.dev",
    "ASSETS_PUBLIC_URL": "https://creator-os-assetes.winwcag.com"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "content-gen",
      "database_id": "817de96b-2bb4-4b97-abbf-0250dada047d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "content-gen",
      "preview_bucket_name": "content-gen"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "dd019f649ca94471823f631b1dfe5e85",
      "preview_id": "7833db39bc0445ff8458c219e56b0b28"
    }
  ],

  "workflows": [
    {
      "name": "generation-workflow",
      "binding": "GENERATION_WORKFLOW",
      "class_name": "GenerationWorkflow"
    },
    {
      "name": "publish-workflow",
      "binding": "PUBLISH_WORKFLOW",
      "class_name": "PublishWorkflow"
    }
  ],

  // ffmpeg-in-a-container for long-video stitching (Flows: generate/combine/continue).
  // Requires the Workers Paid plan with Containers enabled; local dev needs Docker.
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./containers/sandbox/Dockerfile",
      "instance_type": "standard",
      "max_instances": 5
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "Sandbox", "name": "Sandbox" }]
  },
  "migrations": [{ "new_sqlite_classes": ["Sandbox"], "tag": "v1" }]

  // Secrets (set via: wrangler secret put SECRET_NAME):
  // CLERK_SECRET_KEY
  // OPENAI_API_KEY
  // META_APP_ID
  // META_APP_SECRET
  // TIKTOK_APP_ID
  // TIKTOK_APP_SECRET
  // REPLICATE_API_TOKEN
  // SLACK_WEBHOOK_URL
  // SUPER_ADMIN_SECRET  ← HMAC key for impersonation tokens (generate with: openssl rand -hex 32)
}
